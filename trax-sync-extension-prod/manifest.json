{
    "manifest_version": 3,
    "name": "TraxStore Auto-Sync (PROD)",
    "version": "1.0",
    "description": "Otomatis narik cookie Eldorado buat TraxStore versi Vercel",
    "permissions": ["cookies", "tabs"],
    "host_permissions": ["https://www.eldorado.gg/*", "*://*.vercel.app/*"],
    "content_scripts": [
        {
            "matches": ["*://*.vercel.app/*"],
            "js": ["content.js"]
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}
